# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated list of origins allowed to call the API (the Next.js dev server)
CORS_ORIGINS=http://localhost:3000

# Playwright
HEADLESS=true
NAV_TIMEOUT_MS=45000
STEP_TIMEOUT_MS=5000

# Extra Groq models tried in order when the previous one hits its daily token limit
GROQ_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# Parallel browsers for test runs
RUN_WORKERS=4
# Resource types blocked during test runs (add "image" for more speed)
BLOCK_RESOURCES=font,media
